@model CRUD.Models.Prestamo
@{
    ViewData["Title"] = "Editar préstamo";
    var crudHeader = new CrudPageHeaderViewModel
    {
        Title = "Editar préstamo",
        IconClass = "fa-pen-to-square",
        Subtitle = "Modifique los datos del préstamo"
    };
}

<div class="container-fluid">
    <partial name="_CrudTempDataAlerts" />
    <partial name="_CrudPageHeader" model="crudHeader" />
    <div class="row justify-content-center">
        <div class="crud-form-shell-wide">
            <div class="card shadow-sm crud-card">
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Estado" class="form-label fw-semibold">Estado</label>
                                <select asp-for="Estado" class="form-select" asp-items="Html.GetEnumSelectList<CRUD.Models.Prestamo.EstadoPrestamo>()">
                                    <option value="">Seleccione un estado</option>
                                </select>
                                <span asp-validation-for="Estado" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Multa" class="form-label fw-semibold">Multa ($)</label>
                                <input asp-for="Multa" type="number" class="form-control" min="0" step="1" />
                                <span asp-validation-for="Multa" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="InicPrestamo" class="form-label fw-semibold">Fecha de inicio</label>
                                <input asp-for="InicPrestamo" type="date" class="form-control" />
                                <span asp-validation-for="InicPrestamo" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="FinPrestamo" class="form-label fw-semibold">Fecha de fin</label>
                                <input asp-for="FinPrestamo" type="date" class="form-control" />
                                <span asp-validation-for="FinPrestamo" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="ClienteId" class="form-label fw-semibold">Cliente</label>
                                <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.ClienteId">
                                    <option value="">Seleccione un cliente</option>
                                </select>
                                <span asp-validation-for="ClienteId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="LibroId" class="form-label fw-semibold">Libro</label>
                                <select asp-for="LibroId" class="form-select" asp-items="ViewBag.LibroId">
                                    <option value="">Seleccione un libro</option>
                                </select>
                                <span asp-validation-for="LibroId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="EmpleadoId" class="form-label fw-semibold">Empleado</label>
                                <select asp-for="EmpleadoId" class="form-select" asp-items="ViewBag.EmpleadoId">
                                    <option value="">Seleccione un empleado</option>
                                </select>
                                <span asp-validation-for="EmpleadoId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary me-md-2">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save"></i> Guardar cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
