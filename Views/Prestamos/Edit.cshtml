@model CRUD.Models.Prestamo

@{
    ViewData["Title"] = "Editar Préstamo";
}

<div class="container-fluid">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Editar Préstamo</h1>
            <p class="text-muted mb-0">Modifica los datos del préstamo</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>Volver al listado
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="Id" />
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Estado" class="form-label">Estado del Préstamo</label>
                        <select asp-for="Estado" class="form-select" asp-items="Html.GetEnumSelectList<CRUD.Models.Prestamo.EstadoPrestamo>()">
                            <option value="">Seleccione un estado</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Multa" class="form-label">Multa ($)</label>
                        <input asp-for="Multa" type="number" class="form-control" min="0" step="0.01" />
                        <span asp-validation-for="Multa" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="InicPrestamo" class="form-label">Fecha de Inicio</label>
                        <input asp-for="InicPrestamo" type="date" class="form-control" />
                        <span asp-validation-for="InicPrestamo" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="FinPrestamo" class="form-label">Fecha de Fin</label>
                        <input asp-for="FinPrestamo" type="date" class="form-control" />
                        <span asp-validation-for="FinPrestamo" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="ClienteId" class="form-label">Cliente</label>
                        <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.ClienteId">
                            <option value="">Seleccione un cliente</option>
                        </select>
                        <span asp-validation-for="ClienteId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="LibroId" class="form-label">Libro</label>
                        <select asp-for="LibroId" class="form-select" asp-items="ViewBag.LibroId">
                            <option value="">Seleccione un libro</option>
                        </select>
                        <span asp-validation-for="LibroId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="EmpleadoId" class="form-label">Empleado</label>
                        <select asp-for="EmpleadoId" class="form-select" asp-items="ViewBag.EmpleadoId">
                            <option value="">Seleccione un empleado</option>
                        </select>
                        <span asp-validation-for="EmpleadoId" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk me-2"></i>Guardar Cambios
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fa-solid fa-xmark me-2"></i>Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
