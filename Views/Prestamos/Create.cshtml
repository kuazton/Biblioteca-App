@model CRUD.Models.Prestamo
@{
    ViewData["Title"] = "Nuevo préstamo";
    var crudHeader = new CrudPageHeaderViewModel { Title = "Crear nuevo préstamo", IconClass = "fa-handshake" };
}

<div class="container-fluid">
    <partial name="_CrudTempDataAlerts" />
    <partial name="_CrudPageHeader" model="crudHeader" />
    <div class="row justify-content-center">
        <div class="crud-form-shell-wide">
            <div class="card shadow-sm crud-card">
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="Estado" class="form-label fw-semibold"></label>
                            <select asp-for="Estado" class="form-select" asp-items="Html.GetEnumSelectList<CRUD.Models.Prestamo.EstadoPrestamo>()">
                                <option value="">-- Seleccionar estado --</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="InicPrestamo" class="form-label fw-semibold"></label>
                            <input asp-for="InicPrestamo" type="date" class="form-control" />
                            <span asp-validation-for="InicPrestamo" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="FinPrestamo" class="form-label fw-semibold"></label>
                            <input asp-for="FinPrestamo" type="date" class="form-control" />
                            <span asp-validation-for="FinPrestamo" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Multa" class="form-label fw-semibold"></label>
                            <input asp-for="Multa" type="number" min="0" step="1" class="form-control" placeholder="0" />
                            <span asp-validation-for="Multa" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ClienteId" class="form-label fw-semibold"></label>
                            <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.ClienteId">
                                <option value="">-- Seleccionar cliente --</option>
                            </select>
                            <span asp-validation-for="ClienteId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="LibroId" class="form-label fw-semibold"></label>
                            <select asp-for="LibroId" class="form-select" asp-items="ViewBag.LibroId">
                                <option value="">-- Seleccionar libro --</option>
                            </select>
                            <span asp-validation-for="LibroId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <input asp-for="EmpleadoId" type="hidden" />
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary me-md-2">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-plus"></i> Crear préstamo
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
