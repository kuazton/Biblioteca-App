@model CRUD.Models.Prestamo

@{
    ViewData["Title"] = "Eliminar Préstamo";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 text-danger">Eliminar Préstamo</h1>
            <p class="text-muted mb-0">¿Está seguro que desea eliminar este préstamo?</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>Volver al listado
        </a>
    </div>

    <div class="card shadow-sm border-danger">
        <div class="card-body">
            <div class="alert alert-warning" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                <strong>¡Atención!</strong> Esta acción no se puede deshacer.
            </div>

            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Estado:</dt>
                        <dd class="col-sm-8">
                            @if (Model?.Estado == CRUD.Models.Prestamo.EstadoPrestamo.Activo)
                            {
                                <span class="badge bg-success">@Model.Estado</span>
                            }
                            else if (Model?.Estado == CRUD.Models.Prestamo.EstadoPrestamo.Retrasado)
                            {
                                <span class="badge bg-danger">@Model.Estado</span>
                            }
                            else if (Model?.Estado == CRUD.Models.Prestamo.EstadoPrestamo.Devuelto)
                            {
                                <span class="badge bg-info">@Model.Estado</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Model?.Estado</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Fecha Inicio:</dt>
                        <dd class="col-sm-8">@Model?.InicPrestamo.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Fecha Fin:</dt>
                        <dd class="col-sm-8">@Model?.FinPrestamo.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Multa:</dt>
                        <dd class="col-sm-8">
                            @if (Model?.Multa > 0)
                            {
                                <span class="text-danger fw-bold">$@Model.Multa</span>
                            }
                            else
                            {
                                <span class="text-muted">$0.00</span>
                            }
                        </dd>
                    </dl>
                </div>

                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Cliente:</dt>
                        <dd class="col-sm-8">@Model?.Cliente?.UserName</dd>

                        <dt class="col-sm-4">Libro:</dt>
                        <dd class="col-sm-8">@Model?.Libro?.Titulo</dd>

                        <dt class="col-sm-4">Empleado:</dt>
                        <dd class="col-sm-8">@Model?.Empleado?.UserName</dd>
                    </dl>
                </div>
            </div>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="fa-solid fa-trash-can me-2"></i>Confirmar Eliminación
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fa-solid fa-xmark me-2"></i>Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
