@model CRUD.Models.ViewModels.PaginacionResultado<CRUD.Models.Prestamo>

@{
    ViewData["Title"] = "Index";
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-times-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fas fa-handshake"></i> Gestión de Préstamos
        </h2>
        <a asp-action="Create" class="btn btn-success btn-lg">
            <i class="fas fa-plus"></i> Nuevo Préstamo
        </a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th class="fw-medium th-title" scope="col">Estado</th>
                <th class="fw-medium th-title" scope="col">Inicio</th>
                <th class="fw-medium th-title" scope="col">Fin</th>
                <th class="fw-medium th-title" scope="col">Multa</th>
                <th class="fw-medium th-title" scope="col">Cliente</th>
                <th class="fw-medium th-title" scope="col">Libro</th>
                <th class="fw-medium th-title" scope="col">Empleado</th>
                <th class="fw-medium th-title" scope="col">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Datos) {
                <tr>
                    <td scope="row">
                        @if (item.Estado == CRUD.Models.Prestamo.EstadoPrestamo.Activo)
                        {
                            <span class="badge bg-success">@item.Estado</span>
                        }
                        else if (item.Estado == CRUD.Models.Prestamo.EstadoPrestamo.Retrasado)
                        {
                            <span class="badge bg-danger">@item.Estado</span>
                        }
                        else if (item.Estado == CRUD.Models.Prestamo.EstadoPrestamo.Devuelto)
                        {
                            <span class="badge bg-info">@item.Estado</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@item.Estado</span>
                        }
                    </td>
                    <td>@item.InicPrestamo.ToString("dd/MM/yyyy")</td>
                    <td>@item.FinPrestamo.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (item.Multa > 0)
                        {
                            <span class="text-danger fw-bold">$@item.Multa</span>
                        }
                        else
                        {
                            <span class="text-muted">$0.00</span>
                        }
                    </td>
                    <td>@item.Cliente?.UserName</td>
                    <td>@item.Libro?.Titulo</td>
                    <td>@item.Empleado?.UserName</td>
                    <td class="text-center">
                        <div class="btn-group" role="group" aria-label="Acciones">
                            <a asp-action="Details" asp-route-id="@item.Id" 
                                class="btn btn-sm btn-action-color" 
                                title="Ver detalles">
                                <i class="fa-regular fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" 
                                class="btn btn-sm btn-action-color" 
                                title="Editar préstamo">
                                <i class="fa-regular fa-pen-to-square"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" 
                                class="btn btn-sm btn-action-color" 
                                title="Eliminar préstamo">
                                <i class="fa-regular fa-trash-can text-danger"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
            </td>
        </tr>
    </tbody>
</table>
