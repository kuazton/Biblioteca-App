@model CRUD.Models.ViewModels.PaginacionResultado<CRUD.Models.Prestamo>

@{
    ViewData["Title"] = "Index";
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-times-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fas fa-handshake"></i> Gestión de Préstamos
        </h2>
        <a asp-action="Create" class="btn btn-success btn-lg">
            <i class="fas fa-plus"></i> Nuevo Préstamo
        </a>
    </div>
</div>

<div class="w-100 shadow p-3 m-3 rounded-4">
    <input 
        type="text"
        name="filter"
        id="busqueda-prestamos"
        placeholder="Buscar por cliente, libro o empleado..."
        class="form-control bg-body-tertiary rounded-3 border-0"
        hx-get="Prestamos/Index" 
        hx-target="#table-prestamos" 
        hx-trigger="keyup changed delay:300ms"
        autocomplete="off"
        value="@Context.Request.Query["filter"]"
    />
</div>
<div id="table-prestamos" class="table-responsive">
    @await Html.PartialAsync("_TablaPrestamos", Model)
</div>

