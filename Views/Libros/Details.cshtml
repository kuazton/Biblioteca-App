@model CRUD.Models.Libro
@{
    ViewData["Title"] = "Detalle del libro";
    var crudHeader = new CrudPageHeaderViewModel
    {
        Title = "Detalle del libro",
        IconClass = "fa-book-open",
        Subtitle = Model?.Titulo,
        SecondaryAction = Model != null
            ? new CrudHeaderActionLink { ActionName = "Edit", Text = "Editar", EntityId = Model.Id }
            : null
    };
}

<div class="container-fluid">
    <partial name="_CrudPageHeader" model="crudHeader" />
    <div class="row justify-content-center">
        <div class="crud-form-shell-wide">
            <div class="card shadow-sm crud-card">
                <div class="card-body">
                    <dl class="row crud-dl mb-0">
                        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Titulo)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(m => m.Titulo)</dd>
                        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Autor)</dt>
                        <dd class="col-sm-8">@Model?.Autor?.Nombre @Model?.Autor?.Apellido</dd>
                        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Editorial)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(m => m.Editorial!.Nombre)</dd>
                        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Categoria)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(m => m.Categoria!.Nombre)</dd>
                        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.AnioPublicacion)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(m => m.AnioPublicacion)</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
