@model CRUD.Models.Libro
@{
    ViewData["Title"] = "Nuevo libro";
    var crudHeader = new CrudPageHeaderViewModel { Title = "Nuevo libro", IconClass = "fa-book-open" };
}

<div class="container-fluid">
    <partial name="_CrudTempDataAlerts" />
    <partial name="_CrudPageHeader" model="crudHeader" />
    <div class="row justify-content-center">
        <div class="crud-form-shell">
            <div class="card shadow-sm crud-card">
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="Titulo" class="form-label fw-semibold"></label>
                            <input asp-for="Titulo" class="form-control" placeholder="Título del libro" />
                            <span asp-validation-for="Titulo" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="AutorId" class="form-label fw-semibold"></label>
                            <select asp-for="AutorId" class="form-select" asp-items="ViewBag.AutorId">
                                <option value="">-- Seleccione un autor --</option>
                            </select>
                            <span asp-validation-for="AutorId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="EditorialId" class="form-label fw-semibold"></label>
                            <select asp-for="EditorialId" class="form-select" asp-items="ViewBag.EditorialId">
                                <option value="">-- Seleccione una editorial --</option>
                            </select>
                            <span asp-validation-for="EditorialId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="CategoriaId" class="form-label fw-semibold"></label>
                            <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId">
                                <option value="">-- Seleccione una categoría --</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="AnioPublicacion" class="form-label fw-semibold"></label>
                            <input asp-for="AnioPublicacion" class="form-control" placeholder="Año" />
                            <span asp-validation-for="AnioPublicacion" class="text-danger"></span>
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary me-md-2">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-plus"></i> Crear libro
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
