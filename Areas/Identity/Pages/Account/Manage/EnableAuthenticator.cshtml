@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Aplicación autenticadora";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h2 class="crud-page-title mb-3"><i class="fa-solid fa-mobile-screen-button me-2"></i>@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="card shadow-sm crud-card">
    <div class="card-body">
        <p class="text-muted">Para usar una aplicación autenticadora sigue estos pasos:</p>
        <ol class="ps-3">
            <li class="mb-3">
                <p>Instala una app de autenticación en dos pasos (Microsoft Authenticator, Google Authenticator, etc.).</p>
            </li>
            <li class="mb-3">
                <p>Escanea el código QR o introduce esta clave: <kbd class="user-select-all">@Model.SharedKey</kbd></p>
                <div class="alert alert-info py-2"><a href="https://go.microsoft.com/fwlink/?Linkid=852423" class="alert-link">Cómo habilitar códigos QR</a></div>
                <div id="qrCode"></div>
                <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
            </li>
            <li>
                <p>Cuando la app muestre un código de un solo uso, introdúcelo aquí:</p>
                <div class="row justify-content-center">
                    <div class="crud-form-shell">
                        <form id="send-code" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                            <div class="mb-3">
                                <label asp-for="Input.Code" class="form-label fw-semibold">Código de verificación</label>
                                <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="Código de 6 dígitos" />
                                <span asp-validation-for="Input.Code" class="text-danger"></span>
                            </div>
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <a asp-page="./TwoFactorAuthentication" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                                <button type="submit" class="btn btn-warning btn-lg">
                                    <i class="fas fa-check me-1"></i>Verificar y activar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </li>
        </ol>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var el = document.getElementById('qrCode');
            var data = document.getElementById('qrCodeData');
            if (el && data) {
                new QRCode(el, { text: data.getAttribute('data-url'), width: 180, height: 180 });
            }
        });
    </script>
}
