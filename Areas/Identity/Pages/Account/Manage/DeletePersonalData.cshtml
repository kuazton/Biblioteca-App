@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Eliminar cuenta";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h2 class="crud-page-title mb-3 text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>@ViewData["Title"]</h2>
<div class="card shadow-sm crud-card border-danger">
    <div class="card-body">
        <div class="alert alert-warning" role="alert">
            <strong>Esta acción es irreversible.</strong> Se eliminarán todos tus datos y se cerrará la cuenta.
        </div>
        <form id="delete-user" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            @if (Model.RequirePassword)
            {
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label fw-semibold"></label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Confirma con tu contraseña" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
            }
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <a asp-page="./PersonalData" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                <button class="btn btn-danger btn-lg" type="submit">
                    <i class="fas fa-trash-can me-1"></i>Eliminar datos y cerrar cuenta
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
