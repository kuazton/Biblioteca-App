@page
@model DownloadPersonalDataModel
@{
    ViewData["Title"] = "Descargar datos";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h2 class="crud-page-title mb-3"><i class="fa-solid fa-download me-2"></i>@ViewData["Title"]</h2>
<div class="card shadow-sm crud-card">
    <div class="card-body">
        <p class="text-muted mb-3">La descarga se inicia al enviar el formulario desde la página de datos personales.</p>
        <a asp-page="./PersonalData" class="btn btn-outline-secondary btn-lg">
            <i class="fas fa-arrow-left me-1"></i>Volver a datos personales
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
