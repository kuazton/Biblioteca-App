@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Restablecer autenticador";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h2 class="crud-page-title mb-3"><i class="fa-solid fa-rotate me-2"></i>@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="card shadow-sm crud-card border-warning">
    <div class="card-body">
        <div class="alert alert-warning" role="alert">
            <p class="mb-2"><strong>Si restableces la clave, el autenticador dejará de funcionar hasta que lo configures de nuevo.</strong></p>
            <p class="mb-0 small">Se desactiva 2FA hasta completar la nueva configuración. Si no la terminas, podrías perder acceso.</p>
        </div>
        <form id="reset-authenticator-form" method="post" class="d-flex flex-wrap gap-2">
            <a asp-page="./TwoFactorAuthentication" class="btn btn-outline-secondary btn-lg">Cancelar</a>
            <button id="reset-authenticator-button" class="btn btn-danger btn-lg" type="submit">Restablecer clave de autenticador</button>
        </form>
    </div>
</div>
