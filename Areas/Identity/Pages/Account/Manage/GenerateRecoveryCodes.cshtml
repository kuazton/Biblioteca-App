@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generar códigos de recuperación";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h2 class="crud-page-title mb-3"><i class="fa-solid fa-key me-2"></i>@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="card shadow-sm crud-card">
    <div class="card-body">
        <div class="alert alert-warning" role="alert">
            <p class="mb-2"><strong>Guarda estos códigos en un lugar seguro.</strong></p>
            <p class="mb-2 small">Si pierdes el dispositivo y no tienes códigos de recuperación, podrías perder el acceso a la cuenta.</p>
            <p class="mb-0 small">Generar códigos nuevos no cambia la clave del autenticador. Para eso usa <a asp-page="./ResetAuthenticator">restablecer autenticador</a>.</p>
        </div>
        <form method="post" class="d-flex flex-wrap gap-2">
            <a asp-page="./TwoFactorAuthentication" class="btn btn-outline-secondary btn-lg">Volver</a>
            <button class="btn btn-danger btn-lg" type="submit">Generar códigos de recuperación</button>
        </form>
    </div>
</div>
