@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Autenticación en dos pasos";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h2 class="crud-page-title mb-3"><i class="fa-solid fa-shield-halved me-2"></i>@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="card shadow-sm crud-card">
    <div class="card-body">
        @{
            var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
            @if (consentFeature?.CanTrack ?? true)
            {
                @if (Model.Is2faEnabled)
                {
                    if (Model.RecoveryCodesLeft == 0)
                    {
                        <div class="alert alert-danger">
                            <strong>No te quedan códigos de recuperación.</strong>
                            <p class="mb-0"><a asp-page="./GenerateRecoveryCodes">Genera un nuevo conjunto de códigos</a> antes de poder entrar con un código de recuperación.</p>
                        </div>
                    }
                    else if (Model.RecoveryCodesLeft == 1)
                    {
                        <div class="alert alert-danger">
                            <strong>Te queda 1 código de recuperación.</strong>
                            <p class="mb-0">Puedes <a asp-page="./GenerateRecoveryCodes">generar códigos nuevos</a>.</p>
                        </div>
                    }
                    else if (Model.RecoveryCodesLeft <= 3)
                    {
                        <div class="alert alert-warning">
                            <strong>Te quedan @Model.RecoveryCodesLeft códigos de recuperación.</strong>
                            <p class="mb-0">Conviene <a asp-page="./GenerateRecoveryCodes">generar un nuevo conjunto</a>.</p>
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 mb-4">
                        @if (Model.IsMachineRemembered)
                        {
                            <form method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary">Olvidar este navegador</button>
                            </form>
                        }
                        <a asp-page="./Disable2fa" class="btn btn-outline-danger">Desactivar 2FA</a>
                        <a asp-page="./GenerateRecoveryCodes" class="btn btn-warning">Restablecer códigos de recuperación</a>
                    </div>
                }

                <h3 class="h5 fw-semibold mb-3">Aplicación autenticadora</h3>
                <div class="d-flex flex-wrap gap-2">
                    @if (!Model.HasAuthenticator)
                    {
                        <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-warning">Agregar aplicación autenticadora</a>
                    }
                    else
                    {
                        <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-warning">Configurar aplicación autenticadora</a>
                        <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-outline-secondary">Restablecer aplicación autenticadora</a>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-danger mb-0">
                    <strong>No se ha aceptado la política de privacidad y cookies.</strong>
                    <p class="mb-0">Debes aceptarla antes de poder usar la autenticación en dos pasos.</p>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
