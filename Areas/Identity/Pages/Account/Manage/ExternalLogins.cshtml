@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "Accesos externos";
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<h2 class="crud-page-title mb-3"><i class="fa-solid fa-right-to-bracket me-2"></i>@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="card shadow-sm crud-card">
    <div class="card-body">
        @if (Model.CurrentLogins?.Count > 0)
        {
            <h3 class="h5 fw-semibold mb-3">Proveedores vinculados</h3>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <tbody>
                        @foreach (var login in Model.CurrentLogins)
                        {
                            <tr>
                                <td id="@($"login-provider-{login.LoginProvider}")">@login.ProviderDisplayName</td>
                                <td class="text-end">
                                    @if (Model.ShowRemoveButton)
                                    {
                                        <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post" class="d-inline">
                                            <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                                            <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Quitar @login.ProviderDisplayName">Quitar</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (Model.OtherLogins?.Count > 0)
        {
            <h3 class="h5 fw-semibold mb-3 mt-4">Vincular otro proveedor</h3>
            <form id="link-login-form" asp-page-handler="LinkLogin" method="post">
                <div id="socialLoginList" class="d-flex flex-wrap gap-2">
                    @foreach (var provider in Model.OtherLogins)
                    {
                        <button id="@($"link-login-button-{provider.Name}")" type="submit" class="btn btn-warning" name="provider" value="@provider.Name" title="@provider.DisplayName">@provider.DisplayName</button>
                    }
                </div>
            </form>
        }
    </div>
</div>
