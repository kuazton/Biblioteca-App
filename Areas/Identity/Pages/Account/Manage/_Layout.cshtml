@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Views/Shared/_Layout.cshtml";
    }
}

<div class="container-fluid identity-manage-layout py-2">
    <h1 class="identity-manage-main-title mb-1">
        <i class="fa-solid fa-user-gear me-2"></i>Mi cuenta
    </h1>
    <p class="text-muted mb-4">Perfil, correo, contraseña y seguridad</p>
    <div class="row g-4 align-items-start">
        <div class="col-lg-3">
            <div class="card shadow-sm crud-card identity-manage-nav-card">
                <div class="card-body p-3">
                    <partial name="_ManageNav" />
                </div>
            </div>
        </div>
        <div class="col-lg-9">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
