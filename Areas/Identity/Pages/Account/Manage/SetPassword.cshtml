@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Establecer contraseña";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h2 class="crud-page-title mb-3"><i class="fa-solid fa-key me-2"></i>@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="card shadow-sm crud-card">
    <div class="card-body">
        <p class="text-muted mb-4">
            No tienes contraseña local en este sitio. Agrega una para poder iniciar sesión sin un acceso externo.
        </p>
        <div class="row justify-content-center">
            <div class="crud-form-shell">
                <form id="set-password-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label fw-semibold"></label>
                        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" placeholder="Nueva contraseña" />
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirmar contraseña" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">Volver al inicio</a>
                        <button type="submit" class="btn btn-warning btn-lg">
                            <i class="fas fa-check me-1"></i>Establecer contraseña
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
